; La couche Mino des ruches (ADR-012, ADR-023), appliquée par tools/mkhive
; aux ruches de base quand xtask construit le disque. La base est encore
; celle de la version épinglée de ReactOS : les ruches de son LiveCD, que
; boot/bootdata/livecd.inf de ReactOS avait changées. La couche les ramène
; à un système installé (les valeurs de hivesft.inf et hivedef.inf), et met
; son premier démarrage en mode installation.

[Version]
Signature = "$Windows NT$"

[DelReg]

; Les dossiers du shell que le LiveCD posait sous \Profiles : un système
; installé laisse shell32 les calculer.
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders","Common Documents"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders","Common Desktop"
HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders","Desktop"
HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders","Personal"

; Le verrouillage du poste et le changement de mot de passe, que le LiveCD
; interdisait.
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DisableLockWorkstation"
HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System","DisableLockWorkstation"
HKCU,"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System","DisableChangePassword"

[AddReg]

; Le premier démarrage en mode installation (ADR-023) : samsrv y crée les
; comptes (Administrator, Guest), winlogon y lance CmdLine au lieu de
; l'ouverture de session ; minoinit.exe finit l'installation (profils,
; NTUSER.DAT de Default User), remet SetupType à 0, réécrit les ruches et
; redémarre.
HKLM,"SYSTEM\Setup","SetupType",0x00010001,1
HKLM,"SYSTEM\Setup","SystemSetupInProgress",0x00010001,1
HKLM,"SYSTEM\Setup","CmdLine",0x00020000,"%SystemRoot%\system32\minoinit.exe"

; Le nom de la machine, que l'installation de ReactOS demande à l'utilisateur.
HKLM,"SYSTEM\CurrentControlSet\Control\ComputerName\ComputerName","ComputerName",0x00000000,"MINO"
;
; Son nom DNS : l'installation l'écrit par SetComputerNameExW
; (ComputerNamePhysicalDnsHostname : NV Hostname), et sur un système
; démarré Hostname le reprend ; le domaine DNS est vide. GetComputerNameEx
; et SetComputerNameEx les lisent (DnsHostname, DnsDomain…).
HKLM,"SYSTEM\CurrentControlSet\Services\Tcpip\Parameters","NV Hostname",0x00000000,"MINO"
HKLM,"SYSTEM\CurrentControlSet\Services\Tcpip\Parameters","Hostname",0x00000000,"MINO"
HKLM,"SYSTEM\CurrentControlSet\Services\Tcpip\Parameters","NV Domain",0x00000000,""
HKLM,"SYSTEM\CurrentControlSet\Services\Tcpip\Parameters","Domain",0x00000000,""

; Le répertoire des profils d'un système installé (le LiveCD : \Profiles).
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList","ProfilesDirectory",0x00020000,"%SystemDrive%\Documents and Settings"

; Le répertoire des programmes et celui des fichiers communs, que syssetup
; écrit à l'installation de ReactOS (InitializeProgramFilesDir, en REG_SZ
; développé) : msi en tire ProgramFilesFolder et CommonFilesFolder, et
; installait sans eux dans son répertoire courant (C:\WINDOWS\System32).
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion","ProgramFilesDir",0x00000000,"C:\Program Files"
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion","CommonFilesDir",0x00000000,"C:\Program Files\Common Files"

; Le répertoire de msi.dll, que syssetup écrit à l'installation de ReactOS
; ([Classes] de syssetup.inf, AddReg de RegistrationPhase2 : %11%, le
; répertoire système) : l'installeur d'OpenOffice ne charge msi.dll que de
; là (aoo_msi_load), et disait sans lui « You have Windows Installer
; '0.1244568.1244716' » (une DLLVERSIONINFO jamais remplie). L'autre valeur
; de la section, InstallRoot du .NET Framework, n'a pas de répertoire à
; nommer.
HKLM,"SOFTWARE\Microsoft\Windows\CurrentVersion\Installer","InstallerLocation",0x00000000,"C:\WINDOWS\system32"

; Les paramètres régionaux de l'utilisateur, que la page des paramètres
; régionaux de l'installation de ReactOS écrit (la clé du LiveCD est vide) :
; winlogon les lit à l'ouverture de session (SetDefaultLanguage), et la
; ferme sans eux. Ils passent de HKU\.DEFAULT au NTUSER.DAT de Default User
; (minoinit.exe), puis au profil de chaque utilisateur.
HKCU,"Control Panel\International","Locale",0x00000000,"00000409"

; L'ouverture de session automatique d'Administrator, sans mot de passe
; (SetAutoAdminLogon de syssetup) ; son domaine est le nom de la machine.
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","AutoAdminLogon",0x00000000,"1"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultUserName",0x00000000,"Administrator"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultDomainName",0x00000000,"MINO"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon","DefaultPassword",0x00000000,""

; L'ICD OpenGL du pilote d'affichage (ADR-025) : win32k le nomme « Mesa »
; à ExtEscape(OPENGL_GETINFO) ; opengl32 lit ici sa DLL (cargo xtask
; icd-build) et refuse l'ICD si Version ou DriverVersion diffèrent de ce que
; dit le pilote (win32k::display::OpenglIcd::MESA). Flags n'est que tracé.
; Sans le fichier, opengl32 garde son rendu logiciel.
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa","Dll",0x00000000,"mesaicd.dll"
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa","Version",0x00010001,2
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa","DriverVersion",0x00010001,1
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\Mesa","Flags",0x00010001,1
