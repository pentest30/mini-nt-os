; The exports of gdi32.dll (ReactOS 0.4.16, i386) that the Win32 test
; programs call, for their import library (`cargo xtask` builds it with
; dlltool --kill-at). stdcall functions carry their argument bytes (@N); the
; DLL exports them undecorated.
LIBRARY gdi32.dll
EXPORTS
CombineRgn@16
CreateFontW@56
CreateRectRgn@16
DeleteDC@4
DeleteObject@4
ExtSelectClipRgn@12
ExtTextOutW@32
GdiFlush@0
GetClipBox@8
GetObjectType@4
GetRgnBox@8
GetStockObject@4
GetTextExtentExPointW@28
GetTextExtentPoint32W@16
GetTextMetricsW@8
IntersectClipRect@20
PatBlt@24
SelectClipRgn@8
SelectObject@8
SetBkColor@8
SetBkMode@8
SetRectRgn@20
SetTextColor@8
TextOutW@20
