#ifndef _NTDLL_APITEST_PRECOMP_H_
#define _NTDLL_APITEST_PRECOMP_H_
/* La précompilation autonome des apitests ntdll : la leur
 * (modules/rostests/apitests/ntdll/precomp.h) suppose le SDK généré de
 * ReactOS ; celle-ci n'en tient que les include utiles, contre le SDK
 * recopié (winnt.h overlay compris). */
#include <stdio.h>
#define WIN32_NO_STATUS
#define _INC_WINDOWS
#define COM_NO_WINDOWS_H
#include <apitest.h>
#include <apitest_guard.h>
#include <ndk/ntndk.h>
#endif
