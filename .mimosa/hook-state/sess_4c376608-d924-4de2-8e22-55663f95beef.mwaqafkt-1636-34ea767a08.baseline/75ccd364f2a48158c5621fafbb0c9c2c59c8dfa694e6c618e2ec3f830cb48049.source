#ifndef _KERNEL32_APITEST_PRECOMP_H_
#define _KERNEL32_APITEST_PRECOMP_H_
/* La précompilation autonome des apitests kernel32 : la leur suppose le
 * SDK généré de ReactOS ; celle-ci n'en tient que les include utiles,
 * contre le SDK recopié (winnt.h overlay compris). */
#include <stdio.h>
#define WIN32_NO_STATUS
#define _INC_WINDOWS
#define COM_NO_WINDOWS_H
#include <windows.h>
#include <apitest.h>
#include <apitest_guard.h>
#include <strsafe.h>
#endif
