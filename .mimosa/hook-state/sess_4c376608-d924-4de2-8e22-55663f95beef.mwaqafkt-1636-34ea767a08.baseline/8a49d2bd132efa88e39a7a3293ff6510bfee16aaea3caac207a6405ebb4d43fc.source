[package]
name    = "win32k"
version.workspace = true
edition.workspace = true

[lib]
name = "win32k"

[dependencies]
abi      = { path = "../../abi" }
ex       = { path = "../ex" }
glyph    = { path = "../../libs/glyph" }
hal      = { path = "../hal" }
ke       = { path = "../ke" }
mm       = { path = "../mm" }
ob       = { path = "../ob" }
pe       = { path = "../../libs/pe" }
ps       = { path = "../ps" }
log      = { workspace = true }

[dev-dependencies]
pe       = { path = "../../libs/pe", features = ["builder"] }
